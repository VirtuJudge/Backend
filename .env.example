# Runtime environment configuration for host processes (e.g. uvicorn, alembic, smoke tests).
#
# Configuration files:
# - .env: Used by host runtime and development tools. Never commit to version control.
# - .env.local: Generated automatically by `bash scripts/local-stack.sh up` with
#   isolated, random credentials for Docker Compose services.
#
# To connect host development tools to services running in Docker Compose,
# copy the generated credentials privately from .env.local into your .env:
# - BACKEND_DB_PASSWORD -> DATABASE_URL password
# - MINIO_ROOT_USER     -> OBJECT_STORAGE_ACCESS_KEY
# - MINIO_ROOT_PASSWORD -> OBJECT_STORAGE_SECRET_KEY

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Local PostgreSQL (copy BACKEND_DB_PASSWORD from .env.local)
DATABASE_URL=postgresql+asyncpg://virtujudge_backend:BACKEND_DB_PASSWORD@localhost:5432/virtujudge
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Object Storage / MinIO (copy credentials from .env.local)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=virtujudge
OBJECT_STORAGE_ACCESS_KEY=MINIO_ROOT_USER
OBJECT_STORAGE_SECRET_KEY=MINIO_ROOT_PASSWORD
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=900
OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=900

# Abandoned upload cleanup
# ASSET_CLEANUP_ENABLED=true  # default: enabled in development/production, disabled in test
ASSET_CLEANUP_INTERVAL_SECONDS=300.0
ASSET_CLEANUP_BATCH_SIZE=100
ASSET_CLEANUP_RETENTION_SECONDS=86400
ASSET_CLEANUP_LEASE_SECONDS=300
ASSET_CLEANUP_TOMBSTONE_DELAY_SECONDS=86400

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
AI_WORKER_SHARED_SECRET=

# Mail backend: "fake" (default and always used in Compose) or "gmail" (for host application delivery)
# Keep all Gmail settings blank except host/port. Gmail credentials must never be passed to Compose.
MAIL_BACKEND=fake
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_FROM_ADDRESS=
GMAIL_SMOKE_ALLOWLIST=

FRONTEND_URL=https://app.example.com
